# Copia este archivo a .env y completa los valores.
# El .env real NO se sube al repositorio (está en .gitignore).

# Puerto del servidor (opcional, default 3000)
# PORT=3000

# Ambiente (development | production)
# NODE_ENV=development

# Orígenes permitidos para CORS (separados por coma)
# ALLOWED_ORIGINS=http://localhost:5173

# Clave de cifrado de datos sensibles (email, teléfono de clientes).
# OBLIGATORIA en producción. 32 bytes en hex (64 caracteres).
# Generar: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=
