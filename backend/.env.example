# Copia este archivo a .env y completa los valores.
# El .env real NO se sube al repositorio (está en .gitignore).

# Puerto del servidor (opcional, default 3000)
# PORT=3000

# Ambiente (development | production)
# NODE_ENV=development

# Orígenes permitidos para CORS (separados por coma)
# ALLOWED_ORIGINS=http://localhost:5173

# Cadena de conexión a PostgreSQL (Neon). OBLIGATORIA en producción.
# Usar la connection string POOLED de Neon, con sslmode=require. Ejemplo:
# DATABASE_URL=postgresql://usuario:password@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Clave de cifrado de datos sensibles (email, teléfono de clientes).
# OBLIGATORIA en producción. 32 bytes en hex (64 caracteres).
# Generar: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# Autenticación AWS Cognito. OBLIGATORIAS en producción.
# En desarrollo, si se dejan vacías, el backend usa un modo "auth dev"
# que no valida tokens reales (solo para trabajar local).
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_REGION=us-east-1
