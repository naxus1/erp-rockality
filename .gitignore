# ============================================
# ERP Rockality - .gitignore
# ============================================

# ---------- Dependencies ----------
node_modules/
.pnp
.pnp.js

# ---------- Build outputs ----------
dist/
build/
.next/
out/
*.tsbuildinfo

# ---------- Environment variables ----------
.env
.env.local
.env.development
.env.production
.env.*.local

# ---------- SQLite / Database ----------
*.db
*.db-journal
*.db-wal
*.db-shm
data/

# ---------- AWS SAM ----------
.aws-sam/
samconfig.toml

# ---------- IDE ----------
.vscode/
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~

# ---------- OS ----------
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# ---------- Logs ----------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------- Test coverage ----------
coverage/
.nyc_output/

# ---------- Misc ----------
*.tgz
.cache/
.temp/
.tmp/

# ---------- Credentials (NEVER commit) ----------
*.pem
*.key
credentials.json
aws-credentials*
